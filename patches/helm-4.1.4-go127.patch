diff --git a/pkg/cmd/bridge_version_test.go b/pkg/cmd/bridge_version_test.go
new file mode 100644
--- /dev/null
+++ b/pkg/cmd/bridge_version_test.go
@@ -0,0 +1,22 @@
+package cmd
+
+import (
+	"strings"
+	"testing"
+
+	"helm.sh/helm/v4/internal/version"
+)
+
+func TestShortVersionBuildMetadata(t *testing.T) {
+	info := version.Get()
+	if !strings.Contains(info.Version, "+") || len(info.GitCommit) < 7 {
+		t.Skip("run with build metadata and git commit linker fields")
+	}
+	got := formatVersion(true)
+	if strings.Count(got, "+") != 1 {
+		t.Fatalf("invalid semantic version build metadata: %s", got)
+	}
+	if !strings.HasSuffix(got, ".g"+info.GitCommit[:7]) {
+		t.Fatalf("short version lost source identity: %s", got)
+	}
+}
